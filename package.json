{
  "name": "@avsholeh/opencode-mini-session",
  "version": "1.0.0",
  "description": "Floating mini side-chat overlay for the opencode TUI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/index.js"
  },
  "files": [
    "dist",
    "tui.js",
    "tui.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "opencode": ">=2.0.0"
  },
  "dependencies": {
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "solid-js": "^1.9.15"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.1.4",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6"
  },
  "devDependencies": {
    "@opencode/client": "^2.1.4",
    "@opencode/plugin": "^2.1.4",
    "@opencode/theme": "^2.1.4",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "prepack": "bun scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
